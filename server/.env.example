# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre-cle-anon
# SECRET : uniquement sur le serveur (Render). Ne jamais mettre dans Vercel / frontend / Git.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# --- Sécurité des codes d'abonnement ---
# Secret d'au moins 32 caractères aléatoires (ex. : openssl rand -hex 32). SECRET.
# Si vous le changez, tous les codes déjà générés mais non activés deviennent inutilisables.
CODE_HMAC_SECRET=remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum

# --- Application ---
APP_URL=http://localhost:5173
# Origines autorisées (CORS), séparées par des virgules
ALLOWED_ORIGINS=http://localhost:5173
# Domaine technique des comptes employés sans email (doit correspondre à VITE_EMPLOYEE_EMAIL_DOMAIN)
EMPLOYEE_EMAIL_DOMAIN=employes.couture-gestion.app
APP_TIMEZONE=Africa/Bamako
PORT=3000
NODE_ENV=development
